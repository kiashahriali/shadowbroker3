PORT=3000

# ---- Aircraft -------------------------------------------------------------
# No key needed: adsb.lol + adsb.fi + airplanes.live + OpenSky are merged.
# Optional: free OpenSky account (client credentials) -> much higher quota.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ---- Vessels --------------------------------------------------------------
# Digitraffic (Baltic Sea) works with no key. For GLOBAL ships add a free key
# from https://aisstream.io
AISSTREAM_API_KEY=
# Optional: limit AIS to a region "lat1,lon1,lat2,lon2" (south-west, then north-east)
# AIS_BBOX=
# AIS_MAX_VESSELS=15000

# ---- Conflicts / protests (GDELT, no key) ----------------------------------
# GDELT_WINDOW_HOURS=24

# ---- Markets ----------------------------------------------------------------
# Yahoo Finance, Binance, gold-api.com, ECB/Frankfurter and Google News RSS are
# used without keys. Nothing to configure.
