+
+/** Extract the layers we care about from a WMTS GetCapabilities document. */
+export function parseGibsCapabilities(xml: string, ids: string[]): Record<string, CapsEntry> {
+  const found: Record<string, CapsEntry> = {};
+
+  for (const id of ids) {
+    const marker = `<ows:Identifier>${id}</ows:Identifier>`;
+    const at = xml.indexOf(marker);
+    if (at < 0) continue;
+
+    const end = xml.indexOf("</Layer>", at);
+    const block = xml.slice(at, end < 0 ? at + 8000 : end);
+
+    const title = /<ows:Title[^>]*>([^<]*)<\/ows:Title>/.exec(xml.slice(Math.max(0, at - 400), at + 200))?.[1];
+    const format = /<Format>([^<]+)<\/Format>/.exec(block)?.[1] || "image/png";
+    const tms = /<TileMatrixSetLink>\s*<TileMatrixSet>([^<]+)<\/TileMatrixSet>/.exec(block)?.[1];
+    const latest = /<Dimension>[\s\S]*?<Default>([^<]+)<\/Default>/.exec(block)?.[1] || null;
+
+    if (!tms) continue;
+
+    found[id] = {
+      title: decode(title || id),
+      tms: tms.trim(),
+      ext: format.includes("jpeg") || format.includes("jpg") ? "jpg" : "png",
+      latest: latest ? latest.trim() : null
+    };
+  }
+
+  return found;
+}
+
+let capsCache: { at: number; data: Record<string, CapsEntry>; ok: boolean; detail: string } = {
+  at: 0,
+  data: {},
+  ok: false,
+  detail: "not loaded"
+};
+
+async function loadCapabilities(force = false) {
+  if (!force && Date.now() - capsCache.at < 10 * 60 * 1000) return capsCache;
+
+  try {
+    const response = await fetch(CAPS_URL, {
+      headers: { "User-Agent": "SHADOWBROKER/3.0", Accept: "application/xml" },
+      signal: AbortSignal.timeout(60000)
+    });
+
+    if (!response.ok) throw new Error(`HTTP ${response.status}`);
+
+    const xml = await response.text();
+    const data = parseGibsCapabilities(xml, CANDIDATES.map(c => c.id));
+
+    capsCache = {
+      at: Date.now(),
+      data,
+      ok: Object.keys(data).length > 0,
+      detail: `NASA GIBS - ${Object.keys(data).length}/${CANDIDATES.length} layers found`
+    };
+  } catch (err) {
+    capsCache = {
+      at: Date.now() - 8 * 60 * 1000,      // retry in ~2 min
+      data: capsCache.data,
+      ok: false,
+      detail: `GIBS capabilities unavailable: ${err instanceof Error ? err.message : String(err)}`
+    };
+  }
+
+  return capsCache;
+}
+
+export function buildTileUrl(id: string, time: string | null, tms: string, ext: string) {
+  return `${GIBS}/${id}/default/${time || "default"}/${tms}/{z}/{y}/{x}.${ext}`;
+}
+
+export async function getSatelliteLayers(): Promise<{
+  layers: SatelliteLayerInfo[];
+  ok: boolean;
+  detail: string;
+  updatedAt: string;
+}> {
+  const caps = await loadCapabilities();
+  const layers: SatelliteLayerInfo[] = [];
+
+  for (const c of CANDIDATES) {
+    const entry = caps.data[c.id];
+
+    if (!entry && (caps.ok || !c.offline)) continue;   // GIBS does not list it -> do not offer it
+
+    const tms = entry?.tms || c.offline!.tms;
+    const ext = entry?.ext || c.offline!.ext;
+    const level = Number(/Level(\d+)/.exec(tms)?.[1] ?? 7);
+
+    layers.push({
+      id: c.id,
+      name: c.name,
+      platform: c.platform,
+      kind: c.kind,
+      cadence: c.cadence,
+      resolution: c.resolution,
+      description: c.description,
+      tiles: buildTileUrl(c.id, entry?.latest || null, tms, ext),
+      tileSize: 256,
+      maxzoom: level,
+      latest: entry?.latest || null,
+      center: c.center,
+      available: true
+    });
+  }
+
+  return { layers, ok: layers.length > 0, detail: caps.detail, updatedAt: new Date(caps.at).toISOString() };
+}
+
+/* ---------------------------------------------------------------- Sentinel-2 */
+
+const sceneCache = new Map<string, { at: number; scenes: SatelliteScene[]; detail: string }>();
+
+export function sceneTileTemplate(id: string) {
+  return (
+    `${PC_DATA}/tiles/WebMercatorQuad/{z}/{x}/{y}@1x?collection=sentinel-2-l2a&item=${encodeURIComponent(id)}` +
+    `&assets=visual&asset_bidx=visual%7C1%2C2%2C3&nodata=0&format=png`
+  );
+}
+
+export function scenePreviewUrl(id: string) {
+  return (
+    `${PC_DATA}/preview.png?collection=sentinel-2-l2a&item=${encodeURIComponent(id)}` +
+    `&assets=visual&asset_bidx=visual%7C1%2C2%2C3&nodata=0&format=png`
+  );
+}
+
+export function parseStacItems(items: any[]): SatelliteScene[] {
+  const newestPerTile = new Map<string, SatelliteScene>();
+
+  for (const item of items) {
+    const id = String(item?.id || "");
+    const props = item?.properties || {};
+    const bbox = item?.bbox as number[] | undefined;
+    if (!id || !bbox || bbox.length < 4 || !props.datetime) continue;
+
+    const ring = item?.geometry?.coordinates?.[0] as [number, number][] | undefined;
+
+    const scene: SatelliteScene = {
+      id,
+      collection: String(item.collection || "sentinel-2-l2a"),
+      datetime: String(props.datetime),
+      platform: String(props.platform || "Sentinel-2"),
+      cloud: typeof props["eo:cloud_cover"] === "number" ? Math.round(props["eo:cloud_cover"] * 10) / 10 : null,
+      bbox: [bbox[0], bbox[1], bbox[2], bbox[3]],
+      center: [(bbox[0] + bbox[2]) / 2, (bbox[1] + bbox[3]) / 2],
+      footprint: Array.isArray(ring) ? ring.map(p => [p[0], p[1]] as [number, number]) : [],
+      tiles: sceneTileTemplate(id),
+      preview: scenePreviewUrl(id),
+      link: `https://planetarycomputer.microsoft.com/api/stac/v1/collections/sentinel-2-l2a/items/${encodeURIComponent(id)}`,
+      tile: props["s2:mgrs_tile"] ? String(props["s2:mgrs_tile"]) : null
+    };
+
+    const key = scene.tile || id;
+    const prev = newestPerTile.get(key);
+    if (!prev || prev.datetime < scene.datetime) newestPerTile.set(key, scene);
+  }
+
+  return [...newestPerTile.values()].sort((a, b) => b.datetime.localeCompare(a.datetime));
+}
+
+export async function getScenes(bbox: [number, number, number, number], hours: number, maxCloud: number, limit: number) {
+  const round = (n: number) => Math.round(n * 2) / 2;
+  const key = [...bbox.map(round), hours, maxCloud, limit].join("|");
+  const hit = sceneCache.get(key);
+
+  if (hit && Date.now() - hit.at < 120000) return { scenes: hit.scenes, detail: hit.detail, ok: true };
+
+  const end = new Date();
+  const start = new Date(end.getTime() - hours * 3600 * 1000);
+
+  const body = {
+    collections: ["sentinel-2-l2a"],
+    bbox,
+    datetime: `${start.toISOString()}/${end.toISOString()}`,
+    query: { "eo:cloud_cover": { lt: maxCloud } },
+    sortby: [{ field: "datetime", direction: "desc" }],
+    limit
+  };
+
+  try {
+    const response = await fetch(PC_STAC, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", Accept: "application/geo+json", "User-Agent": "SHADOWBROKER/3.0" },
+      body: JSON.stringify(body),
+      signal: AbortSignal.timeout(25000)
+    });
+
+    if (!response.ok) throw new Error(`HTTP ${response.status}`);
+
+    const data = (await response.json()) as { features?: any[] };
+    const scenes = parseStacItems(data.features || []);
+    const detail = `Sentinel-2 L2A via Planetary Computer - ${scenes.length} scenes (last ${hours} h)`;
+
+    sceneCache.set(key, { at: Date.now(), scenes, detail });
+    if (sceneCache.size > 200) sceneCache.delete(sceneCache.keys().next().value as string);
+
+    return { scenes, detail, ok: true };
+  } catch (err) {
+    return {
+      scenes: hit?.scenes || [],
+      detail: `Sentinel-2 search failed: ${err instanceof Error ? err.message : String(err)}`,
+      ok: false
+    };
+  }
+}
+
+export async function satelliteStatus() {
+  const caps = await loadCapabilities();
+
+  return {
+    "NASA GIBS imagery": { status: caps.ok ? "public" : "offline", detail: caps.detail },
+    "Sentinel-2 (Planetary Computer)": {
+      status: "public",
+      detail: "STAC search + tiler, queried on demand (no key)"
+    }
+  };
+}
+
+export const satelliteInternals = { parseGibsCapabilities, parseStacItems, CANDIDATES };
diff --git a/selftest.ts b/selftest.ts
new file mode 100644
index 0000000..7132662
--- /dev/null
+++ b/selftest.ts
@@ -0,0 +1,189 @@
+// Live connectivity self-test for every data source used by SHADOWBROKER.
+//
+//   npm run selftest
+//
+// Run it where the app is hosted (Render shell) or on your own machine: it calls the
+// real services, so it tells you which providers answer from THAT network. Cloud
+// IPs are sometimes rate-limited by free APIs, and this is the quickest way to see it.
+
+import { unzipSync } from "fflate";
+import WebSocket from "ws";
+import { conflictInternals } from "./conflicts";
+import { getSatelliteLayers, getScenes } from "./satellite";
+import { getAnalysis, getHistory, getMarkets } from "./markets";
+import { parseDigitrafficLocations } from "./ais";
+
+type Result = { name: string; ok: boolean; detail: string };
+const results: Result[] = [];
+
+async function check(name: string, fn: () => Promise<string>) {
+  const started = Date.now();
+
+  try {
+    const detail = await fn();
+    results.push({ name, ok: true, detail: `${detail} (${Date.now() - started} ms)` });
+  } catch (err) {
+    results.push({ name, ok: false, detail: err instanceof Error ? err.message : String(err) });
+  }
+
+  const r = results[results.length - 1];
+  console.log(`${r.ok ? "PASS" : "FAIL"}  ${r.name.padEnd(34)} ${r.detail}`);
+}
+
+async function json(url: string, init?: RequestInit) {
+  const response = await fetch(url, {
+    headers: { "User-Agent": "SHADOWBROKER-selftest/3.0", Accept: "application/json" },
+    signal: AbortSignal.timeout(30000),
+    ...init
+  });
+
+  if (!response.ok) throw new Error(`HTTP ${response.status}`);
+  return response.json() as Promise<any>;
+}
+
+async function imageOk(url: string) {
+  const response = await fetch(url, { signal: AbortSignal.timeout(30000) });
+  const type = response.headers.get("content-type") || "";
+  if (!response.ok) throw new Error(`HTTP ${response.status}`);
+  if (!type.startsWith("image/")) throw new Error(`not an image (${type})`);
+  return `${type}, ${(await response.arrayBuffer()).byteLength} bytes`;
+}
+
+async function main() {
+  console.log("SHADOWBROKER self-test\n");
+
+  /* ---------------------------------------------------------------- aircraft */
+  const points: [string, string][] = [
+    ["adsb.lol point", "https://api.adsb.lol/v2/lat/51.5/lon/-0.5/dist/250"],
+    ["adsb.fi point", "https://opendata.adsb.fi/api/v2/lat/51.5/lon/-0.5/dist/250"],
+    ["airplanes.live point", "https://api.airplanes.live/v2/point/51.5/-0.5/250"]
+  ];
+
+  for (const [name, url] of points) {
+    await check(`Aircraft: ${name}`, async () => {
+      const d = await json(url);
+      if (!Array.isArray(d.ac) || !d.ac.length) throw new Error("no aircraft returned");
+      return `${d.ac.length} aircraft over London`;
+    });
+    await new Promise(r => setTimeout(r, 1200));     // respect 1 request / second
+  }
+
+  await check("Aircraft: adsb.lol military", async () => {
+    const d = await json("https://api.adsb.lol/v2/mil");
+    return `${d.ac?.length ?? 0} military aircraft worldwide`;
+  });
+
+  await check("Aircraft: OpenSky (anonymous)", async () => {
+    const d = await json("https://opensky-network.org/api/states/all");
+    return `${d.states?.length ?? 0} states worldwide`;
+  });
+
+  /* ------------------------------------------------------------------ ships */
+  await check("Ships: Digitraffic locations", async () => {
+    const rows = parseDigitrafficLocations(
+      await json("https://meri.digitraffic.fi/api/ais/v1/locations", {
+        headers: { "Digitraffic-User": "SHADOWBROKER/3.0", "Accept-Encoding": "gzip" }
+      })
+    );
+    if (!rows.length) throw new Error("no vessels");
+    return `${rows.length} vessels in the Baltic`;
+  });
+
+  await check("Ships: AISStream.io", async () => {
+    const key = process.env.AISSTREAM_API_KEY;
+    if (!key) throw new Error("AISSTREAM_API_KEY is not set (free key: aisstream.io)");
+
+    return await new Promise<string>((resolve, reject) => {
+      const ws = new WebSocket("wss://stream.aisstream.io/v0/stream");
+      const timer = setTimeout(() => { ws.terminate(); reject(new Error("no message within 15 s")); }, 15000);
+
+      ws.on("open", () =>
+        ws.send(JSON.stringify({ APIKey: key, BoundingBoxes: [[[50, -5], [60, 10]]], FilterMessageTypes: ["PositionReport"] }))
+      );
+      ws.on("message", data => {
+        clearTimeout(timer);
+        ws.close();
+        const m = JSON.parse(data.toString());
+        m.error ? reject(new Error(m.error)) : resolve(`first message: ${m.MessageType}`);
+      });
+      ws.on("error", e => { clearTimeout(timer); reject(e); });
+    });
+  });
+
+  /* ------------------------------------------------------------ conflicts */
+  await check("Unrest: GDELT latest export", async () => {
+    const text = await (await fetch("https://data.gdeltproject.org/gdeltv2/lastupdate.txt", { signal: AbortSignal.timeout(20000) })).text();
+    const url = text.split("\n").find(l => l.includes(".export.CSV.zip"))?.trim().split(/\s+/).pop();
+    if (!url) throw new Error("export file not listed");
+
+    const zip = new Uint8Array(await (await fetch(url.replace("http://", "https://"), { signal: AbortSignal.timeout(45000) })).arrayBuffer());
+    const files = unzipSync(zip);
+    const csv = new TextDecoder().decode(files[Object.keys(files)[0]]);
+    const events = conflictInternals.parseExportCsv(csv);
+    return `${events.length} conflict/protest events in one 15-min file`;
+  });
+
+  /* ------------------------------------------------------------ satellite */
+  let gibsTile: string | null = null;
+
+  await check("Satellite: NASA GIBS capabilities", async () => {
+    const r = await getSatelliteLayers();
+    if (!r.layers.length) throw new Error(r.detail);
+    if (!r.layers.some(l => l.latest)) throw new Error(`capabilities not readable: ${r.detail}`);
+    gibsTile = r.layers[0].tiles;
+    return r.layers.map(l => `${l.name} [${l.latest ?? "?"}]`).join("; ");
+  });
+
+  await check("Satellite: GIBS tile download", async () => {
+    if (!gibsTile) throw new Error("no layer available");
+    return imageOk(gibsTile.replace("{z}", "3").replace("{y}", "3").replace("{x}", "3"));
+  });
+
+  let scene: any = null;
+
+  await check("Satellite: Sentinel-2 scene search", async () => {
+    const r = await getScenes([5, 45, 15, 52], 24 * 10, 60, 10);
+    if (!r.ok || !r.scenes.length) throw new Error(r.detail);
+    scene = r.scenes[0];
+    return `${r.scenes.length} scenes, newest ${scene.datetime}`;
+  });
+
+  await check("Satellite: Sentinel-2 tile render", async () => {
+    if (!scene?.tiles) throw new Error("no scene");
+    const [w, s, e, n] = scene.bbox as number[];
+    const lon = (w + e) / 2;
+    const lat = (s + n) / 2;
+    const z = 9;
+    const x = Math.floor(((lon + 180) / 360) * 2 ** z);
+    const y = Math.floor(((1 - Math.log(Math.tan((lat * Math.PI) / 180) + 1 / Math.cos((lat * Math.PI) / 180)) / Math.PI) / 2) * 2 ** z);
+    return imageOk(scene.tiles.replace("{z}", String(z)).replace("{x}", String(x)).replace("{y}", String(y)));
+  });
+
+  /* -------------------------------------------------------------- markets */
+  await check("Markets: quote board", async () => {
+    const m = await getMarkets();
+    const ok = m.items.filter(i => i.price !== null);
+    const missing = m.items.filter(i => i.price === null).map(i => i.symbol);
+    if (!ok.length) throw new Error("no quotes at all");
+    return `${ok.length}/${m.items.length} priced` + (missing.length ? `; missing: ${missing.join(", ")}` : "");
+  });
+
+  for (const symbol of ["XAUUSD", "XAGUSD", "WTI", "BRENT", "NATGAS", "GASOLINE", "DIESEL", "EURUSD", "BTCUSDT"]) {
+    await check(`Markets: ${symbol} chart (1M)`, async () => {
+      const h = await getHistory(symbol, "1M");
+      if (!h.points.length) throw new Error(h.detail || "no points");
+      return `${h.points.length} points via ${h.source}`;
+    });
+  }
+
+  await check("Markets: analysis XAUUSD", async () => {
+    const a = await getAnalysis("XAUUSD");
+    return `${a.bias} (${a.confidence}), ${a.headlines.length} headlines. ${a.detail ?? ""}`;
+  });
+
+  const failed = results.filter(r => !r.ok);
+  console.log(`\n${results.length - failed.length}/${results.length} checks passed`);
+  process.exit(failed.length ? 1 : 0);
+}
+
+void main();
