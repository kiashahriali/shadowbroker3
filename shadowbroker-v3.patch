+.tech-grid span {
+  color: #6f8795;
+  font-family: "JetBrains Mono", monospace;
+  font-size: 7px;
+}
+
+.tech-grid strong {
+  color: #dbe7ee;
+  font-family: "JetBrains Mono", monospace;
+  font-size: 9px;
+}
+
+.headline-title {
+  margin: 4px 0 8px;
+  color: #8ea3b0;
+  font-size: 9px;
+  font-weight: 700;
+}
+
+.headline-list {
+  display: flex;
+  flex-direction: column;
+}
+
+.headline {
+  display: flex;
+  gap: 8px;
+  padding: 8px 0;
+  border-bottom: 1px solid var(--border);
+  color: #c0ced6;
+  font-size: 10px;
+  line-height: 1.5;
+  text-decoration: none;
+}
+
+.headline:hover { color: #fff; }
+
+.headline small {
+  display: block;
+  margin-top: 3px;
+  color: #667d8a;
+  font-size: 8px;
+}
+
+.headline-dot {
+  flex-shrink: 0;
+  width: 14px;
+  color: #657b88;
+  font-size: 9px;
+}
+
+.headline-dot.up { color: var(--positive); }
+.headline-dot.down { color: var(--negative); }
+
+.analysis-disclaimer {
+  margin: 12px 0 0;
+  color: #6a808d;
+  font-size: 9px;
+  line-height: 1.7;
+}
+
+.market-refresh {
+  flex-shrink: 0;
+}
